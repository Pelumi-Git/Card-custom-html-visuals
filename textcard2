City Card = 
VAR CityName = SELECTEDVALUE('Sales Dataset'[City])

RETURN
"
<style>
.card {
  position: relative;
  width: 220px;
  height: 320px;
  background: mediumturquoise;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: bold;
  border-radius: 15px;
  cursor: pointer;
}

.card::before,
.card::after {
  position: absolute;
  content: '';
  width: 20%;
  height: 20%;
  background-color: lightblue;
  transition: all 0.5s;
}

.card::before {
  top: 0;
  right: 0;
  border-radius: 0 15px 0 100%;
}

.card::after {
  bottom: 0;
  left: 0;
  border-radius: 0 100% 0 15px;
}

.card:hover::before,
.card:hover::after {
  width: 100%;
  height: 100%;
  border-radius: 15px;
}

.card:hover::after {
  content: 'View " & CityName & " Details';
  display:flex;
  align-items:center;
  justify-content:center;
}
</style>

<div class='card'>
" & CityName & "
</div>
"
