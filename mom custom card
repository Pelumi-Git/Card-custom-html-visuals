momhtml = 
VAR RevenueValue = [NEWMOM]
VAR CardColor = IF(RevenueValue > 0, "#16a34a", "#dc2626")  -- Green if positive, Red if negative
RETURN
"
<style>
.card {
  width: 190px;
  height: 254px;
  background: " & CardColor & ";
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border-radius: 20px;
  font-family: 'Segoe UI', sans-serif;
  color: #fff;
}

.card h2 {
  z-index: 1;
  font-size: 2em;
  font-weight: bold;
  text-align: center;
  margin: 0;
}

.card::before {
  content: '';
  position: absolute;
  width: 100px;
  height: 130%;
  background-image: linear-gradient(180deg, rgba(255,255,255,0.2), rgba(255,255,255,0));
  animation: rotBGimg 3s linear infinite;
}

@keyframes rotBGimg {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.card::after {
  content: '';
  position: absolute;
  background: rgba(0,0,0,0.2);
  inset: 5px;
  border-radius: 15px;
}
</style>

<div class='card'>
  <h2> " & FORMAT(RevenueValue,"0.0%") & "</h2>
  <div style='position:absolute; bottom:15px; font-size:14px; font-weight:bold;'>MoM Revenue</div>
</div>
"
