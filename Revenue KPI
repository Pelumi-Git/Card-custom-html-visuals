Revenue KPI HTML 2 = 

VAR Revenue = FORMAT([REVENUE], "$#,##0")
VAR RevPerUnit = FORMAT([Revenue Per Unit], "#,##0.00")
RETURN
"
<div style='background-color: black; color: white; padding: 20px; font-family: Segoe UI, sans-serif; display: inline-block; border-radius: 4px;'>
    
    <div style='background-color: white; color: #333; padding: 4px 8px 8px 8px; border-radius: 2px; position: relative; min-width: 180px;'>
        
        <div style='font-size: 9px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: -2px;'>
            Revenue
        </div>
        
        <div style='position: absolute; top: 4px; right: 6px;'>
            <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#666' stroke-width='2'>
                <path d='M12 1v22M17 5H9.5a4.5 4.5 0 1 0 0 9h5a4.5 4.5 0 1 1 0 9H6' />
            </svg>
        </div>

        <div style='font-size: 28px; font-weight: 800; color: #000; line-height: 1.1;'>
            " & Revenue & "
        </div>
    </div>

    <div style='margin-top: 12px; border-top: 1px solid #333; padding-top: 8px;'>
        <span style='font-size: 13px; color: #aaa;'>Revenue per Unit : </span>
        <span style='font-size: 14px; font-weight: 600; color: white;'>" & RevPerUnit & "</span>
    </div>

</div>
"
